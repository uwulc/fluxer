# ============================================================================
#  Settings for one standalone voice server
#
#  Copy this file to <id>.env, fill in the required values and start the
#  server with
#  docker compose -p fluxer-voice-<id> --env-file <id>.env -f voice.compose.yml up -d.
#  Each server needs its own settings file, project name, key and ports.
#  Settings that start with # are optional.
# ============================================================================


# ============================================================================
#  REQUIRED
# ============================================================================

# The ID of the voice server, such as fra-server-2. Use lowercase letters,
# digits and dashes. The container uses voice- followed by this ID as its host
# name on the voice network, and the edge routes /livekit- followed by this ID
# to it.
FLUXER_VOICE_ID=

# The LiveKit API key of this server. Every voice server of an instance needs
# its own key, such as fluxer- followed by the server ID.
FLUXER_VOICE_API_KEY=

# The LiveKit API secret that goes with FLUXER_VOICE_API_KEY, at least 32
# characters, such as the output of openssl rand -hex 32.
FLUXER_VOICE_API_SECRET=

# The URL LiveKit sends its webhooks to. On the Fluxer machine it's
# http://api:8080/webhooks/livekit. On another machine it's the public API
# address followed by /webhooks/livekit.
FLUXER_VOICE_WEBHOOK_URL=


# ============================================================================
#  OPTIONAL
# ============================================================================

# The TCP port for media on this host. LiveKit listens on the same port inside
# the container, and each server on a host needs its own.
#   default:  7881
# FLUXER_VOICE_TCP_PORT=

# The UDP port for media on this host. LiveKit listens on the same port inside
# the container, and each server on a host needs its own.
#   default:  7882
# FLUXER_VOICE_UDP_PORT=

# The public addresses LiveKit gives to clients. Give an IPv4 address, an IPv6
# address, or both with a comma between them, such as 203.0.113.7,2001:db8::7.
# Set FLUXER_VOICE_USE_EXTERNAL_IP to false with it. LiveKit offers an IPv6
# address only when the server's Docker network has IPv6.
# FLUXER_VOICE_NODE_IP=

# The address ranges LiveKit may offer to clients, as a JSON array of ranges
# such as ["::/0"]. rexctl sets it to the families in FLUXER_VOICE_NODE_IP,
# and a server with only IPv6 then offers no private IPv4 address of its
# container. Use [] to offer every address.
#   default:  []
# FLUXER_VOICE_ICE_IPS=

# Whether LiveKit finds its public IP address through STUN. Use true or false.
#   default:  true
# FLUXER_VOICE_USE_EXTERNAL_IP=

# The host address the media ports are published on, for a host with more than
# one public address. When it's empty, Docker publishes them on every address.
# FLUXER_VOICE_BIND_IP=

# The port that voice-http.compose.yml publishes LiveKit's HTTP and WebSocket
# port on, for your own proxy.
#   default:  7880
# FLUXER_VOICE_HTTP_PORT=

# The host address that voice-http.compose.yml publishes
# FLUXER_VOICE_HTTP_PORT on. The default is 127.0.0.1. Use another address of
# the host, or 0.0.0.0 for every address, when your proxy runs in another
# network. Write an IPv6 address in brackets, such as [2001:db8::5]. The port
# has no TLS of its own. Let only your proxy's network connect to it in your
# firewall.
#   default:  127.0.0.1
# FLUXER_VOICE_HTTP_BIND=

# The Docker network the server joins. On a voice machine it's the network of
# the voice edge. On the Fluxer machine it's the network of the instance, such
# as fluxer_fluxer, and Fluxer's own edge routes to the server.
#   default:  fluxer-voice
# FLUXER_VOICE_NETWORK=

# The memory limit for the server's container.
#   default:  2g
# FLUXER_VOICE_MEMORY_LIMIT=

# The soft memory limit of the Go runtime in LiveKit. Keep it at about 85% of
# FLUXER_VOICE_MEMORY_LIMIT.
#   default:  1700MiB
# FLUXER_VOICE_GOMEMLIMIT=

# How long Docker waits for the calls on the server to end when it stops or
# replaces the container, before it stops LiveKit anyway.
#   default:  15m
# FLUXER_VOICE_STOP_GRACE=

# The image the livekit container runs.
#   default:  livekit/livekit-server:v1.12.0
# FLUXER_LIVEKIT_IMAGE=

# How much LiveKit logs. Use debug, info, warn or error.
#   default:  info
# FLUXER_LIVEKIT_LOG_LEVEL=

# The first STUN host LiveKit asks to find its public IP address, as
# host:port. Point it at another STUN host to avoid contacting Google.
#   default:  stun.l.google.com:19302
# FLUXER_LIVEKIT_STUN_PRIMARY=

# The second STUN host LiveKit asks to find its public IP address, as
# host:port.
#   default:  stun1.l.google.com:19302
# FLUXER_LIVEKIT_STUN_SECONDARY=

# TURN servers that browsers and apps get when they join a call, as a JSON
# array of objects with host, port and protocol, and either username and
# credential or secret with an optional ttl, such as
# [{"host":"turn.example.com","port":3478,"protocol":"udp","secret":"a-long-random-secret"}].
# Use udp, tcp or tls for protocol, and a hostname or an IPv4 address for
# host. With secret, LiveKit makes short-lived credentials for each
# participant in the form coturn checks with use-auth-secret, and ttl, a whole
# number from 1, sets how many seconds they last. The bundled voice server and
# the servers you add with rexctl voice add give these to clients, and rexctl
# restarts the added servers one at a time when the list changes. A server
# that joined with rexctl voice join gets the list when it joins and on each
# rexctl upgrade in its voice folder, unless the instance runs an older
# release than the rexctl there. Set it when callers can't connect to a voice
# server directly, such as from networks that allow only port 443. When it's
# empty, clients get no TURN server. A value the API can't read stops it from
# starting, and rexctl config set refuses one.
#   default:  []
# FLUXER_LIVEKIT_TURN_SERVERS=
