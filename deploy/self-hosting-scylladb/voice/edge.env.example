# ============================================================================
#  Settings for the voice edge
#
#  Copy this file to edge.env and start the edge with
#  docker compose -p fluxer-voice-edge --env-file edge.env -f voice-edge.compose.yml up -d.
#  Every setting is optional.
# ============================================================================


# ============================================================================
#  OPTIONAL
# ============================================================================

# The public IPv4 address of the voice machine, when an endpoint uses that
# address and not a hostname. The edge then gives clients that send no server
# name the certificate for that address, which browsers need.
# FLUXER_VOICE_EDGE_IP=

# Whether the voice network gets IPv6. Use true or false. rexctl sets it to
# true when it creates the network on a machine with a public IPv6 address.
# Docker can't add IPv6 to a network that already exists.
#   default:  false
# FLUXER_VOICE_NETWORK_IPV6=

# The email address the voice edge gives Let's Encrypt for notices about its
# certificates. When it's empty, the edge gets certificates without one.
# FLUXER_VOICE_EDGE_EMAIL=
