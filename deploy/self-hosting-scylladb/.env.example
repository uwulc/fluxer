# ============================================================================
#  Fluxer settings for the Docker Compose bundle
#
#  Copy this file to .env, fill in the required values and run docker compose
#  up -d. Settings that start with # are optional and use their default until
#  you remove the #.
#
#  The optional compose files change how Fluxer runs. To use one, list it
#  after docker-compose.yml in COMPOSE_FILE, such as
#  COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml.
#
#    docker-compose.proxy.yml           for your own reverse proxy
#    tunnel.compose.yml                 for a tunnel
#    external-object-store.compose.yml  for your own object store
#    ipv6.compose.yml                   for IPv6 on Fluxer's network
#
#  This is the ScyllaDB variant of upstream's bundle. It runs the uwulc
#  images, which are built with the ScyllaDB backend and include fluxer-dev.
#  rexctl does not manage it: rexctl takeover expects the Postgres stack. The
#  rexctl lines under each setting only show what the setting means upstream.
# ============================================================================


# ============================================================================
#  REQUIRED
#
#  Fill these in before the first start.
# ============================================================================

# docker-compose.yml refuses to start without this line. Keep it as it is.
FLUXER_SETTINGS_LOADED=true

# domain
#   The domain Fluxer runs on.
#   type:     hostname
#   example:  chat.example.com
#   rexctl:   rexctl config set domain
FLUXER_DOMAIN=


# ============================================================================
#  FIRST ADMIN ACCOUNT
# ============================================================================

# setup token
#   The account that signs up with this token becomes Fluxer's first admin.
#   Use 32 to 256 characters, such as the output of openssl rand -hex 32. If
#   you leave it empty, the api service makes a token and writes it to its log
#   once, on its first start. docker compose logs api shows it.
#   type:     secret
FLUXER_SETUP_TOKEN=


# ============================================================================
#  SECRETS
#
#  Fill in each empty value before the first start, and keep a copy of .env
#  somewhere safe.
# ============================================================================

# These have fixed values. Keep them as they are unless a setting below tells
# you to change one.
FLUXER_S3_ACCESS_KEY=fluxer
LIVEKIT_API_KEY=fluxer

# Generate each value with this command. Do this once before the first start
# and keep them the same after that, because your stored data depends on them.
#   openssl rand -hex 32
MEILI_MASTER_KEY=
FLUXER_S3_SECRET_KEY=
LIVEKIT_API_SECRET=

# Generate each value with this command.
#   openssl rand -hex 32
FLUXER_SUDO_MODE_SECRET=
FLUXER_CONNECTION_INITIATION_SECRET=
FLUXER_PROFILE_PSEUDONYM_SECRET=
FLUXER_GATEWAY_RPC_AUTH_TOKEN=
FLUXER_ERLANG_COOKIE=
FLUXER_MEDIA_PROXY_SECRET_KEY=
FLUXER_ADMIN_SECRET_KEY_BASE=
FLUXER_ADMIN_OAUTH_CLIENT_SECRET=

# Generate the value with this command.
#   openssl rand -base64 32
FLUXER_MEDIA_PROXY_UPLOAD_RELAY_SECRET_BASE64=

# Generate the value with this command.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -outform DER |
#     base64 | tr -d '\n'
FLUXER_ACTIVITYPUB_SIGNING_KEY_BASE64=

# This is the key pair for push notifications. These commands print the public
# key and then the private key. Do this once before the first start and keep
# the pair the same after that, because your stored data depends on it.
#   openssl ecparam -name prime256v1 -genkey -noout -out vapid.pem
#   openssl ec -in vapid.pem -pubout -outform DER | tail -c 65 | base64 |
#     tr '/+' '_-' | tr -d '=\n'
#   openssl ec -in vapid.pem -outform DER | tail -c +8 | head -c 32 |
#     base64 | tr '/+' '_-' | tr -d '=\n'
#   rm vapid.pem
FLUXER_VAPID_PUBLIC_KEY=
FLUXER_VAPID_PRIVATE_KEY=


# ============================================================================
#  EDGE AND HTTPS
#
#  By default Fluxer listens on ports 80 and 443 and gets its own HTTPS
#  certificate for your domain.
# ============================================================================

# edge.bind
#   The address your reverse proxy or tunnel connects to.
#   type:     address
#   default:  127.0.0.1:8080 with docker-compose.proxy.yml
#             127.0.0.1:80 with tunnel.compose.yml
#   rexctl:   rexctl config set edge.bind
# FLUXER_EDGE_BIND=

# edge.http_port
#   The port Fluxer listens on for HTTP.
#   type:     port
#   default:  80
#   rexctl:   rexctl config set edge.http_port
# FLUXER_HTTP_PORT=

# edge.https_port
#   The port Fluxer listens on for HTTPS. If people connect to this port
#   directly, set FLUXER_PUBLIC_PORT to the same port.
#   type:     port
#   default:  443
#   rexctl:   rexctl config set edge.https_port
# FLUXER_HTTPS_PORT=

# edge.public_port
#   The port people use in Fluxer's address, when it differs from the one
#   Fluxer listens on.
#   type:     port
#   default:  443
#   rexctl:   rexctl config set edge.public_port
# FLUXER_PUBLIC_PORT=

# edge.trusted_proxies
#   Proxies whose client address headers Fluxer trusts. Separate entries with
#   spaces.
#   type:     list
#   default:  127.0.0.1/32
#             private_ranges with docker-compose.proxy.yml
#             private_ranges with tunnel.compose.yml
#   rexctl:   rexctl config set edge.trusted_proxies
# FLUXER_EDGE_TRUSTED_PROXIES=


# ============================================================================
#  VOICE AND VIDEO
#
#  Calls connect directly to this machine on these ports, even when Fluxer is
#  behind your own proxy.
# ============================================================================

# voice.tcp_port
#   The TCP port for voice and video.
#   type:     port
#   default:  7881
#   rexctl:   rexctl config set voice.tcp_port
# FLUXER_LIVEKIT_TCP_PORT=

# voice.udp_port
#   The UDP port for voice and video.
#   type:     port
#   default:  7882
#   rexctl:   rexctl config set voice.udp_port
# FLUXER_LIVEKIT_UDP_PORT=

# voice.public_ip
#   The public IP address voice and video use, when Fluxer can't find it by
#   itself. Set FLUXER_LIVEKIT_NODE_IP to the address and
#   FLUXER_LIVEKIT_USE_EXTERNAL_IP to false.
#   type:     ip
#   rexctl:   rexctl config set voice.public_ip
# FLUXER_LIVEKIT_NODE_IP=
# FLUXER_LIVEKIT_USE_EXTERNAL_IP=


# ============================================================================
#  OBJECT STORAGE
#
#  Leave these unset to use the bundled object store. To use your own
#  S3-compatible store, set them and add external-object-store.compose.yml to
#  COMPOSE_FILE.
# ============================================================================

# storage.endpoint
#   Your own S3-compatible object store.
#   type:     url
#   default:  http://seaweedfs:8333
#   rexctl:   rexctl config set storage.endpoint
# FLUXER_S3_ENDPOINT=

# storage.public_endpoint
#   The object store address browsers use, when it differs from the one Fluxer
#   uses.
#   type:     url
#   rexctl:   rexctl config set storage.public_endpoint
# FLUXER_S3_PUBLIC_ENDPOINT=

# storage.region
#   The object store region.
#   type:     text
#   default:  us-east-1
#   rexctl:   rexctl config set storage.region
# FLUXER_S3_REGION=

# storage.path_style
#   Whether the object store needs path-style addresses.
#   type:     bool
#   default:  true
#   rexctl:   rexctl config set storage.path_style
# FLUXER_S3_FORCE_PATH_STYLE=

# storage.access_key
#   The object store access key. For your own store, change
#   FLUXER_S3_ACCESS_KEY under SECRETS above.
#   type:     text
#   rexctl:   rexctl config set storage.access_key

# storage.secret_key
#   The object store secret key. For your own store, change
#   FLUXER_S3_SECRET_KEY under SECRETS above.
#   type:     secret
#   rexctl:   rexctl config set storage.secret_key


# ============================================================================
#  OUTGOING PROXY
# ============================================================================

# network.http_proxy
#   The proxy Fluxer uses for outgoing HTTP requests.
#   type:     url
#   rexctl:   rexctl config set network.http_proxy
# HTTP_PROXY=

# network.https_proxy
#   The proxy Fluxer uses for outgoing HTTPS requests.
#   type:     url
#   rexctl:   rexctl config set network.https_proxy
# HTTPS_PROXY=

# network.no_proxy
#   Hosts Fluxer connects to without the proxy. Separate hosts with commas.
#   type:     list
#   rexctl:   rexctl config set network.no_proxy
# NO_PROXY=


# ============================================================================
#  IMAGES
#
#  Set one to use your own mirror or another version.
# ============================================================================

# Fluxer's own images. This stack needs the uwulc images: they are built with
# the ScyllaDB backend and include fluxer-dev, which upstream does not publish.
FLUXER_REGISTRY_OWNER=uwulc
FLUXER_REGISTRY=ghcr.io/${FLUXER_REGISTRY_OWNER}
FLUXER_IMAGE_TAG=latest

# images.edge
#   The image for edge.
#   type:     image
#   default:  caddy:2.11-alpine
#   rexctl:   rexctl config set images.edge
# FLUXER_CADDY_IMAGE=

# images.livekit
#   The image for livekit.
#   type:     image
#   default:  livekit/livekit-server:v1.12.0
#   rexctl:   rexctl config set images.livekit
# FLUXER_LIVEKIT_IMAGE=

# images.meilisearch
#   The image for meilisearch.
#   type:     image
#   default:  getmeili/meilisearch:v1.53
#   rexctl:   rexctl config set images.meilisearch
# FLUXER_MEILISEARCH_IMAGE=

# images.nats
#   The image for nats.
#   type:     image
#   default:  nats:2.14-alpine
#   rexctl:   rexctl config set images.nats
# FLUXER_NATS_IMAGE=

# The image for scylladb. Move ScyllaDB one major version at a time.
#   default:  scylladb/scylla:6.2
# FLUXER_SCYLLADB_IMAGE=

# images.seaweedfs
#   The image for seaweedfs.
#   type:     image
#   default:  chrislusf/seaweedfs:4.47
#   rexctl:   rexctl config set images.seaweedfs
# FLUXER_SEAWEEDFS_IMAGE=

# images.valkey
#   The image for valkey.
#   type:     image
#   default:  valkey/valkey:9.1-alpine
#   rexctl:   rexctl config set images.valkey
# FLUXER_VALKEY_IMAGE=


# ============================================================================
#  SCYLLADB
#
#  The bundled scylladb service holds all of Fluxer's data. cassandra-migrate
#  brings its schema up to date on every start.
# ============================================================================

# Set these to use ScyllaDB outside the stack. Backing it up is then yours to
# arrange. The values below are examples. The bundled scylladb service still
# starts unless an override removes it.
# FLUXER_CASSANDRA_HOSTS=scylla1.example.com,scylla2.example.com
# FLUXER_CASSANDRA_PORT=9042
# FLUXER_CASSANDRA_KEYSPACE=fluxer
# FLUXER_CASSANDRA_LOCAL_DC=datacenter1
# FLUXER_CASSANDRA_USERNAME=
# FLUXER_CASSANDRA_PASSWORD=

# Bundled ScyllaDB sizing. FLUXER_SCYLLADB_MEMORY plus
# FLUXER_SCYLLADB_RESERVE_MEMORY must fit inside the memory limit, or ScyllaDB
# refuses to start (it reserves 1.5 GiB for the OS unless told otherwise).
# Developer mode skips the production I/O and kernel checks, which a small host
# fails. Raise the SMP count with the CPUs you give it.
# FLUXER_SCYLLADB_MEMORY_LIMIT=1536mb
# FLUXER_SCYLLADB_SMP=1
# FLUXER_SCYLLADB_MEMORY=750M
# FLUXER_SCYLLADB_RESERVE_MEMORY=512M
# FLUXER_SCYLLADB_DEVELOPER_MODE=1
# FLUXER_SCYLLADB_HEALTHCHECK_TIMEOUT=10s
# FLUXER_SCYLLADB_HEALTHCHECK_RETRIES=20
# FLUXER_SCYLLADB_HEALTHCHECK_START_PERIOD=60s
# FLUXER_CASSANDRA_MIGRATE_MEMORY_LIMIT=256mb

# The one-shot pg-migrate service, which moves an old Postgres-backed instance
# into ScyllaDB. Only `docker compose --profile migrate run --rm pg-migrate`
# reads these. See MIGRATION.md.
# FLUXER_MIGRATE_POSTGRES_HOST=postgres
# FLUXER_MIGRATE_POSTGRES_PORT=5432
# FLUXER_MIGRATE_POSTGRES_DATABASE=fluxer
# FLUXER_MIGRATE_POSTGRES_USERNAME=fluxer
# FLUXER_MIGRATE_POSTGRES_PASSWORD=
# FLUXER_MIGRATE_POSTGRES_KV_TABLE=fluxer_kv
# FLUXER_MIGRATE_TABLES=
# FLUXER_MIGRATE_DRY_RUN=false
